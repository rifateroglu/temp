# Betik çalıştırma kapalı
SetHandler default-handler
Options -ExecCGI -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .phar
<FilesMatch "\.(php\d*|phtml|phps|phar|pl|py|cgi|sh|htaccess|htpasswd)(\.|$)">
    Require all denied
</FilesMatch>
# Dosya adları rastgele üretilir ve üzerine yazılmaz: içerik değişmez, 1 yıl önbelleklenir.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Content-Type-Options "nosniff"
    # Görsel olmayan dosyalar indirilsin (PDF içi JS, polyglot dosyalar)
    <FilesMatch "\.(pdf|doc|docx|xls|xlsx)$">
        Header set Content-Disposition "attachment"
    </FilesMatch>
</IfModule>
